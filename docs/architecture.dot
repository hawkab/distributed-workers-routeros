// Shared model: platform/tools/render-architecture.py
digraph Architecture {
graph [rankdir=TB, compound=true];
node [fontname="sans-serif"];
label="How a task runs \u2014 runtime components\nworker-routeros: Container packaging and supervision of the PHP engine";labelloc=t;
subgraph "cluster_canonical" {
label="Gateway and canonical stores"; style=dashed;
"anchor_canonical" [shape=point,width=0,style=invis];
  "api" [shape=component,label="Gateway HTTPS API\nAssigns attempts and leases\nAccepts results / binary chunks\nAuthenticates each participant"];
  "postgres" [shape=cylinder,label="PostgreSQL\nJobs, attempts, receipts\nInbox / outbox metadata"];
  "artifacts" [shape=cylinder,label="Artifact filesystem\nChunks and sealed files\nContent hashes"];
}
subgraph "cluster_workers" {
label="Compatible execution hosts"; style=dashed;
"anchor_workers" [shape=point,width=0,style=invis];
  "node" [shape=component,label="Node worker\nLinux / Windows"];
  "php" [shape=component,label="PHP CLI worker\nLinux / shared hosting"];
  "android" [shape=component,label="Android service\nJava / Rhino"];
  subgraph "cluster_router" {
  label="RouterOS container"; style=dashed;
  color="#2058ad";penwidth=2.5;
  "anchor_router" [shape=point,width=0,style=invis];
    "router_php" [shape=component,label="PHP execution engine\nSame portable SDK"];
  }
}
"application" [shape=box,label="External application\nCreates tasks\nReads results and artifacts"];
"broker" [shape=box,label="RabbitMQ \u2014 optional bridge\nCommand ingestion / event refs\nWorkers do not claim here"];
"source" [shape=box,label="External HTTP source\nOnly for network tasks"];
"application" -> "api" [label="1  Submit task / 4  Read result"];
"anchor_workers" -> "api" [label="2  Claim (reply: job) / 3  Report / upload",ltail="cluster_workers"];
"api" -> "postgres" [label="SQL transactions"];
"api" -> "artifacts" [label="Binary chunks"];
"api" -> "broker" [label="Event refs / outbox",style=dashed];
"broker" -> "api" [label="Commands / inbox",style=dashed];
"anchor_workers" -> "source" [label="GET / HEAD",ltail="cluster_workers"];
}
